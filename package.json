{
  "name": "mint-condition",
  "version": "0.1.0",
  "description": "A cozy-competitive Christmas toy collector. Toys came alive and unionized.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "balance": "tsx scripts/balance.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "build:artifact": "vite build -c vite.artifact.config.ts && node scripts/artifact-wrap.mjs",
    "curve": "tsx scripts/minigame-curve.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "preact": "^11.1.1",
    "three": "^0.187.0"
  },
  "private": true,
  "type": "module"
}
